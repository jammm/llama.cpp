    %sgi3_a = index.add %qk_base, %sgi3_m : index
    %sgi3_b = index.add %sgi3_a, %srow0 : index
    %sgi3 = index.assume %sgi3_b [range(%sgi3_b, 0, 1073741816)] : index
    %kvr3 = vector.load %k_view[%sgi3] : view<1073741824xf32, #dense> -> vector<8xf32>
    %qvr3 = vector.load %q_view[%sgi3] : view<1073741824xf32, #dense> -> vector<8xf32>
    %kvs3 = scf.select %stk3_ok, %kvr3, %zv8 : vector<8xf32>
