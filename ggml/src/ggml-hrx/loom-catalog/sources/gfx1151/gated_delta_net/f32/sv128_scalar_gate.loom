      %pp9 = scalar.addf<nnan|ninf|nsz> %pp8, %pm9 : f32
      %ss9 = scalar.addf<nnan|ninf|nsz> %ss8, %sm9 : f32
      %ple10 = index.cmp ule, %k10, %tid : index
      %pm10 = scf.select %ple10, %pg10, %f0 : f32
      %sm10 = scf.select %ple10, %f0, %pg10 : f32
      %pp10 = scalar.addf<nnan|ninf|nsz> %pp9, %pm10 : f32
      %ss10 = scalar.addf<nnan|ninf|nsz> %ss9, %sm10 : f32
      %ple11 = index.cmp ule, %k11, %tid : index
      %pm11 = scf.select %ple11, %pg11, %f0 : f32
      %sm11 = scf.select %ple11, %f0, %pg11 : f32
      %pp11 = scalar.addf<nnan|ninf|nsz> %pp10, %pm11 : f32
      %ss11 = scalar.addf<nnan|ninf|nsz> %ss10, %sm11 : f32
      %ple12 = index.cmp ule, %k12, %tid : index
