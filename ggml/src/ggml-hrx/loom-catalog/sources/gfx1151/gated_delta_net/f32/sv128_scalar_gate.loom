      %pp8 = scalar.addf<nnan|ninf|nsz> %pp7, %pm8 : f32
      %ss8 = scalar.addf<nnan|ninf|nsz> %ss7, %sm8 : f32
      %ple9 = index.cmp ule, %k9, %tid : index
