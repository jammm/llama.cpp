  %ic9_r = index.add %wcol, %k9 : index
  %ic9 = index.assume %ic9_r [range(%ic9_r, 0, 127)] : index
  %icb9_m = index.mul %ic9, %s_v : index
  %icb9_a = index.add %state_offset, %icb9_m : index
  %icb9_r = index.add %icb9_a, %row0 : index
  %icb9 = index.assume %icb9_r [range(%icb9_r, 0, 1073741820)] : index
