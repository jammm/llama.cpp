    vector.store %kh2, %km_flat[%sll2] : vector<8xf16>, view<2176xf16, #dense>
    vector.store %qh2, %qm_flat[%sll2] : vector<8xf16>, view<2176xf16, #dense>
    %stk3_r = index.add %t0, %k12 : index
    %stk3_s = index.add %stk3_r, %stokl : index
    %stk3_ok = index.cmp ult, %stk3_s, %n_tokens : index
