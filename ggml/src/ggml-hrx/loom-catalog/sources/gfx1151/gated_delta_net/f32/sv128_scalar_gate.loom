      %sm7 = scf.select %ple7, %f0, %pg7 : f32
      %pp7 = scalar.addf<nnan|ninf|nsz> %pp6, %pm7 : f32
      %ss7 = scalar.addf<nnan|ninf|nsz> %ss6, %sm7 : f32
      %ple8 = index.cmp ule, %k8, %tid : index
