      %pm1 = scf.select %ple1, %pg1, %f0 : f32
      %sm1 = scf.select %ple1, %f0, %pg1 : f32
      %pp1 = scalar.addf<nnan|ninf|nsz> %pm0, %pm1 : f32
      %ss1 = scalar.addf<nnan|ninf|nsz> %sm0, %sm1 : f32
      %ple2 = index.cmp ule, %k2, %tid : index
