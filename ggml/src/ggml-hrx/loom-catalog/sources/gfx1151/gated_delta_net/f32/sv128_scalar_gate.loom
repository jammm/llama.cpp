  %ic12_r = index.add %wcol, %k12 : index
  %ic12 = index.assume %ic12_r [range(%ic12_r, 0, 127)] : index
  %icb12_m = index.mul %ic12, %s_v : index
  %icb12_a = index.add %state_offset, %icb12_m : index
  %icb12_r = index.add %icb12_a, %row0 : index
  %icb12 = index.assume %icb12_r [range(%icb12_r, 0, 1073741820)] : index
  %s12_init = vector.load %si_view[%icb12] : view<1073741824xf32, #dense> -> vector<4xf32>
  %ic13_r = index.add %wcol, %k13 : index
  %ic13 = index.assume %ic13_r [range(%ic13_r, 0, 127)] : index
  %icb13_m = index.mul %ic13, %s_v : index
  %icb13_a = index.add %state_offset, %icb13_m : index
  %icb13_r = index.add %icb13_a, %row0 : index
  %icb13 = index.assume %icb13_r [range(%icb13_r, 0, 1073741820)] : index
  %s13_init = vector.load %si_view[%icb13] : view<1073741824xf32, #dense> -> vector<4xf32>
  %ic14_r = index.add %wcol, %k14 : index
  %ic14 = index.assume %ic14_r [range(%ic14_r, 0, 127)] : index
  %icb14_m = index.mul %ic14, %s_v : index
  %icb14_a = index.add %state_offset, %icb14_m : index
  %icb14_r = index.add %icb14_a, %row0 : index
  %icb14 = index.assume %icb14_r [range(%icb14_r, 0, 1073741820)] : index
  %s14_init = vector.load %si_view[%icb14] : view<1073741824xf32, #dense> -> vector<4xf32>
  %ic15_r = index.add %wcol, %k15 : index
  %ic15 = index.assume %ic15_r [range(%ic15_r, 0, 127)] : index
  %icb15_m = index.mul %ic15, %s_v : index
  %icb15_a = index.add %state_offset, %icb15_m : index
  %icb15_r = index.add %icb15_a, %row0 : index
  %icb15 = index.assume %icb15_r [range(%icb15_r, 0, 1073741820)] : index
  %s15_init = vector.load %si_view[%icb15] : view<1073741824xf32, #dense> -> vector<4xf32>
  %ch_r = index.add %n_tokens, %k15 : index
  %n_chunks = index.div %ch_r, %k16 : index
  %f1 = scalar.constant 1.0 : f32
  %f0 = scalar.constant 0.0 : f32
  %fz8 = vector.constant 0.0 : vector<8xf32>
  %zv8 = vector.constant 0.0 : vector<8xf32>
  %sf0, %sf1, %sf2, %sf3, %sf4, %sf5, %sf6, %sf7, %sf8, %sf9, %sf10, %sf11, %sf12, %sf13, %sf14, %sf15 = scf.for %ch = [%zero to %n_chunks step %one](
      %sa0 = %s0_init : vector<4xf32>,
      %sa1 = %s1_init : vector<4xf32>,
      %sa2 = %s2_init : vector<4xf32>,
      %sa3 = %s3_init : vector<4xf32>,
      %sa4 = %s4_init : vector<4xf32>,
      %sa5 = %s5_init : vector<4xf32>,
      %sa6 = %s6_init : vector<4xf32>,
      %sa7 = %s7_init : vector<4xf32>,
      %sa8 = %s8_init : vector<4xf32>,
      %sa9 = %s9_init : vector<4xf32>,
      %sa10 = %s10_init : vector<4xf32>,
      %sa11 = %s11_init : vector<4xf32>,
      %sa12 = %s12_init : vector<4xf32>,
      %sa13 = %s13_init : vector<4xf32>,
      %sa14 = %s14_init : vector<4xf32>,
      %sa15 = %s15_init : vector<4xf32>) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) {
    %t0 = index.mul %ch, %k16 : index
    // Gate prefix/suffix decays for the chunk, computed once per workgroup
    // in log space. This avoids underflow followed by division of gate
    // products. The raw model gate is already log(g).
    // Masked tokens take g=1, beta=0 so they leave the state alone and drop
    // out of every sum. Threads 0..15 own one token each.
    %gtok_r = index.add %t0, %tid : index
    %gtok_ok = index.cmp ult, %gtok_r, %n_tokens : index
    %gtok_s = scf.select %gtok_ok, %gtok_r, %zero : index
    %gtok = index.assume %gtok_s [range(%gtok_s, 0, 1048575)] : index
    scf.if %tid_lt_c {
      %gbi_m = index.mul %gtok, %sb2 : index
      %gbi_a = index.add %gb_base, %gbi_m : index
      %gbi = index.assume %gbi_a [range(%gbi_a, 0, 1073741823)] : index
      %graw = view.load %g_view[%gbi] : view<1073741824xf32, #dense> -> f32
      %braw = view.load %b_view[%gbi] : view<1073741824xf32, #dense> -> f32
      %gvv = scf.select %gtok_ok, %graw, %f0 : f32
      %bvv = scf.select %gtok_ok, %braw, %f0 : f32
      %gsi = index.add %tid, %k64 : index
      %gsib = index.assume %gsi [range(%gsi, 0, 79)] : index
      view.store %gvv, %gs_flat[%gsib] : f32, view<80xf32, #dense>
      %bsi_m = index.mul %tid, %k4 : index
      %bsib = index.assume %bsi_m [range(%bsi_m, 0, 79)] : index
      view.store %bvv, %gs_flat[%bsib] : f32, view<80xf32, #dense>
    }
    kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
    // c_t, the suffix decay, and log(c_t). Every lane reads all 16
    // log-gates and forms prefix and suffix sums without a cross-lane scan.
    scf.if %tid_lt_c {
      %pg0 = view.load %gs_flat[%k64] : view<80xf32, #dense> -> f32
      %pg1 = view.load %gs_flat[%k65] : view<80xf32, #dense> -> f32
      %pg2 = view.load %gs_flat[%k66] : view<80xf32, #dense> -> f32
      %pg3 = view.load %gs_flat[%k67] : view<80xf32, #dense> -> f32
      %pg4 = view.load %gs_flat[%k68] : view<80xf32, #dense> -> f32
      %pg5 = view.load %gs_flat[%k69] : view<80xf32, #dense> -> f32
      %pg6 = view.load %gs_flat[%k70] : view<80xf32, #dense> -> f32
      %pg7 = view.load %gs_flat[%k71] : view<80xf32, #dense> -> f32
      %pg8 = view.load %gs_flat[%k72] : view<80xf32, #dense> -> f32
      %pg9 = view.load %gs_flat[%k73] : view<80xf32, #dense> -> f32
      %pg10 = view.load %gs_flat[%k74] : view<80xf32, #dense> -> f32
      %pg11 = view.load %gs_flat[%k75] : view<80xf32, #dense> -> f32
      %pg12 = view.load %gs_flat[%k76] : view<80xf32, #dense> -> f32
      %pg13 = view.load %gs_flat[%k77] : view<80xf32, #dense> -> f32
      %pg14 = view.load %gs_flat[%k78] : view<80xf32, #dense> -> f32
      %pg15 = view.load %gs_flat[%k79] : view<80xf32, #dense> -> f32
      %ple0 = index.cmp ule, %k0, %tid : index
