    %sll0_b = index.add %sll0_a, %k0 : index
    %sll0 = index.assume %sll0_b [range(%sll0_b, 0, 2168)] : index
    vector.store %kh0, %km_flat[%sll0] : vector<8xf16>, view<2176xf16, #dense>
    vector.store %qh0, %qm_flat[%sll0] : vector<8xf16>, view<2176xf16, #dense>
    %stk1_r = index.add %t0, %k4 : index
    %stk1_s = index.add %stk1_r, %stokl : index
    %stk1_ok = index.cmp ult, %stk1_s, %n_tokens : index
    %stk1_c = scf.select %stk1_ok, %stk1_s, %zero : index
