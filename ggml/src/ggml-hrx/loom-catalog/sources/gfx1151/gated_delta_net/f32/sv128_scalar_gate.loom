      %pp4 = scalar.addf<nnan|ninf|nsz> %pp3, %pm4 : f32
      %ss4 = scalar.addf<nnan|ninf|nsz> %ss3, %sm4 : f32
      %ple5 = index.cmp ule, %k5, %tid : index
