    %qh1 = vector.fptrunc %qvs1 : vector<8xf32> to vector<8xf16>
    %sll1_m = index.mul %stokl, %k136 : index
    %sll1_a = index.add %sll1_m, %srow0 : index
    %sll1_b = index.add %sll1_a, %k544 : index
    %sll1 = index.assume %sll1_b [range(%sll1_b, 0, 2168)] : index
    vector.store %kh1, %km_flat[%sll1] : vector<8xf16>, view<2176xf16, #dense>
    vector.store %qh1, %qm_flat[%sll1] : vector<8xf16>, view<2176xf16, #dense>
    %stk2_r = index.add %t0, %k8 : index
    %stk2_s = index.add %stk2_r, %stokl : index
    %stk2_ok = index.cmp ult, %stk2_s, %n_tokens : index
    %stk2_c = scf.select %stk2_ok, %stk2_s, %zero : index
    %stk2 = index.assume %stk2_c [range(%stk2_c, 0, 1048575)] : index
    %sgi2_m = index.mul %stk2, %sq2 : index
    %sgi2_a = index.add %qk_base, %sgi2_m : index
    %sgi2_b = index.add %sgi2_a, %srow0 : index
