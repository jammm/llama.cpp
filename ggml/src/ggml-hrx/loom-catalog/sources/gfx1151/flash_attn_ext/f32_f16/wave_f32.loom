// FLASH_ATTN_EXT for head dim 256: single-wave workgroup, 4-query tile with f16 dot2 QK.
// Online softmax consumes 2 key position(s) per loop iteration, 2-key online-softmax blocks.
//
// Generated by work/kdev/gen_fa.py --wave; edit that, not this.
//
// The workgroup is one wave of 32 lanes and lane L owns head-dim elements
// L, L+32, ... (8 of them), so:
//   - k[d,s] and v[d,s] stay unit-stride in d and every load is coalesced;
//   - the q.k reduction is within a single wave, so it lowers to cross-lane
//     shuffles with no workgroup barrier;
//   - the running softmax max and denominator are scalars, identical in every
//     lane, so there is no reduction for them at all.
// The 4 queries of a tile share each k[d,s] and v[d,s] load, cutting K/V
// request volume 4-fold against one query per workgroup.

config.decl @hrx2_shape_fa_d : %value: index where [range(%value, 32, 1024), mul(%value, 32)]
config.decl @hrx2_shape_fa_ntokens : %value: index where [range(%value, 1, 1048576)]
config.decl @hrx2_shape_fa_nheads : %value: index where [range(%value, 1, 1024)]
config.decl @hrx2_shape_fa_nkv : %value: index where [range(%value, 1, 1048576)]
config.decl @hrx2_shape_fa_gqa : %value: index where [range(%value, 1, 1024)]
config.decl @hrx2_shape_fa_q_stride_token : %value: index where [range(%value, 1, 16777216)]
config.decl @hrx2_shape_fa_q_stride_head : %value: index where [range(%value, 1, 16777216)]
config.decl @hrx2_shape_fa_k_stride_pos : %value: index where [range(%value, 1, 16777216)]
config.decl @hrx2_shape_fa_k_stride_head : %value: index where [range(%value, 0, 16777216)]
config.decl @hrx2_shape_fa_v_stride_pos : %value: index where [range(%value, 1, 16777216)]
config.decl @hrx2_shape_fa_v_stride_head : %value: index where [range(%value, 0, 16777216)]
config.decl @hrx2_shape_fa_mask_stride_token : %value: index where [range(%value, 1, 16777216)]
config.decl @hrx2_shape_fa_dst_stride_head : %value: index where [range(%value, 1, 16777216)]
config.decl @hrx2_shape_fa_dst_stride_token : %value: index where [range(%value, 1, 16777216)]

kernel.def export("hrx2_flash_attn_ext_f32_f16_wave") @hrx2_flash_attn_ext_f32_f16_wave() {
