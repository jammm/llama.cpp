  %wave = index.constant 32 : index
  %br = index.constant 4 : index
  %br_m1 = index.constant 3 : index
  %ntokens = config.get @hrx2_shape_fa_ntokens : index
  %nheads = config.get @hrx2_shape_fa_nheads : index
  %nt_up = index.add %ntokens, %br_m1 : index
  %ntiles = index.div %nt_up, %br : index
  %nheads_b = index.assume %nheads [range(%nheads, 1, 1024)] : index
