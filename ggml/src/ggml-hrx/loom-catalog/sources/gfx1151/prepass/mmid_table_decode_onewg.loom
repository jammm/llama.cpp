// Exact ntokens=1 MUL_MAT_ID match-table builder.
//
// The production table kernel launches one 256-thread workgroup per expert.
// At decode there are only eight routing IDs total, so each of those 256
// workgroups performs an eight-ID scan and a 256-step prefix. Here one
// 256-thread workgroup assigns one expert to each lane. Every lane scans the
// same eight IDs in slot order and writes the identical per-expert count and
// packed match sequence. Unused table entries are deliberately untouched,
// matching hrx2_mmid_table.

config.decl @hrx2_shape_mmid_decode_nexperts : %value: index where [range(%value, 256, 256)]
config.decl @hrx2_shape_mmid_decode_nselected : %value: index where [range(%value, 8, 8)]
config.decl @hrx2_shape_mmid_decode_ntokens : %value: index where [range(%value, 1, 1)]

kernel.def export("hrx2_mmid_table_decode_onewg")
    @hrx2_mmid_table_decode_onewg() {
  %one = index.constant 1 : index
  %wg = index.constant 256 : index
  %nexperts0 = config.get @hrx2_shape_mmid_decode_nexperts : index
  %nexperts = index.assume %nexperts0 [range(%nexperts0, 256, 256)] : index
  kernel.launch.config workgroups(%one, %one, %one)
      workgroup_size(%nexperts, %one, %one) : index
} launch(%idx: buffer, %table: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %three = index.constant 3 : index
  %four = index.constant 4 : index
  %five = index.constant 5 : index
  %six = index.constant 6 : index
  %seven = index.constant 7 : index
  %sixteen = index.constant 16 : index
  %zero_i32 = scalar.constant 0 : i32
  %one_i32 = scalar.constant 1 : i32
  %sel0_i32 = scalar.constant 0 : i32
  %sel1_i32 = scalar.constant 1 : i32
  %sel2_i32 = scalar.constant 2 : i32
  %sel3_i32 = scalar.constant 3 : i32
  %sel4_i32 = scalar.constant 4 : i32
  %sel5_i32 = scalar.constant 5 : i32
  %sel6_i32 = scalar.constant 6 : i32
  %sel7_i32 = scalar.constant 7 : i32

  %nselected0 = config.get @hrx2_shape_mmid_decode_nselected : index
  %ntokens0 = config.get @hrx2_shape_mmid_decode_ntokens : index
  %nselected = index.assume %nselected0 [range(%nselected0, 8, 8)] : index
  %ntokens = index.assume %ntokens0 [range(%ntokens0, 1, 1)] : index
  %shape_guard = index.mul %nselected, %ntokens : index

  %lane0 = kernel.workitem.id<x> : index
  %expert = index.assume %lane0 [range(%lane0, 0, 255)] : index
  %expert_i32 = index.cast %expert : index to i32

  %idx_g = buffer.assume.memory_space<global> %idx : buffer
  %table_g = buffer.assume.memory_space<global> %table : buffer
  %idx_na, %table_na = buffer.assume.noalias %idx_g, %table_g : buffer, buffer
  %idx_view = buffer.view %idx_na[%base] : buffer -> view<256xi32, #dense>
  %table_view = buffer.view %table_na[%base] : buffer -> view<4096xi32, #dense>

  // stride = 2 * ntokens * nselected = 16 i32 elements per expert.
  %stride0 = index.mul %shape_guard, %two : index
  %table_base0 = index.mul %expert, %stride0 : index
  %table_base = index.assume %table_base0
      [range(%table_base0, 0, 4080), mul(%table_base0, 16)] : index
  %entries0 = index.add %table_base, %one : index

  %e0 = view.load %idx_view[%zero] : view<256xi32, #dense> -> i32
  %hit0 = scalar.cmpi eq, %e0, %expert_i32 : i32
  scf.if %hit0 {
    view.store %sel0_i32, %table_view[%entries0] : i32, view<4096xi32, #dense>
  }
  %inc0 = scf.select %hit0, %one_i32, %zero_i32 : i32
  %count1 = scalar.addi %zero_i32, %inc0 : i32

  %count1_i = index.cast %count1 : i32 to index
  %slot1_0 = index.add %entries0, %count1_i : index
  %slot1 = index.assume %slot1_0 [range(%slot1_0, 1, 4088)] : index
  %e1 = view.load %idx_view[%one] : view<256xi32, #dense> -> i32
  %hit1 = scalar.cmpi eq, %e1, %expert_i32 : i32
  scf.if %hit1 {
    view.store %sel1_i32, %table_view[%slot1] : i32, view<4096xi32, #dense>
  }
  %inc1 = scf.select %hit1, %one_i32, %zero_i32 : i32
  %count2 = scalar.addi %count1, %inc1 : i32

  %count2_i = index.cast %count2 : i32 to index
  %slot2_0 = index.add %entries0, %count2_i : index
  %slot2 = index.assume %slot2_0 [range(%slot2_0, 1, 4088)] : index
  %e2 = view.load %idx_view[%two] : view<256xi32, #dense> -> i32
  %hit2 = scalar.cmpi eq, %e2, %expert_i32 : i32
  scf.if %hit2 {
    view.store %sel2_i32, %table_view[%slot2] : i32, view<4096xi32, #dense>
  }
  %inc2 = scf.select %hit2, %one_i32, %zero_i32 : i32
  %count3 = scalar.addi %count2, %inc2 : i32

  %count3_i = index.cast %count3 : i32 to index
  %slot3_0 = index.add %entries0, %count3_i : index
  %slot3 = index.assume %slot3_0 [range(%slot3_0, 1, 4088)] : index
  %e3 = view.load %idx_view[%three] : view<256xi32, #dense> -> i32
  %hit3 = scalar.cmpi eq, %e3, %expert_i32 : i32
  scf.if %hit3 {
    view.store %sel3_i32, %table_view[%slot3] : i32, view<4096xi32, #dense>
  }
  %inc3 = scf.select %hit3, %one_i32, %zero_i32 : i32
  %count4 = scalar.addi %count3, %inc3 : i32

  %count4_i = index.cast %count4 : i32 to index
  %slot4_0 = index.add %entries0, %count4_i : index
  %slot4 = index.assume %slot4_0 [range(%slot4_0, 1, 4088)] : index
  %e4 = view.load %idx_view[%four] : view<256xi32, #dense> -> i32
  %hit4 = scalar.cmpi eq, %e4, %expert_i32 : i32
  scf.if %hit4 {
    view.store %sel4_i32, %table_view[%slot4] : i32, view<4096xi32, #dense>
  }
  %inc4 = scf.select %hit4, %one_i32, %zero_i32 : i32
  %count5 = scalar.addi %count4, %inc4 : i32

  %count5_i = index.cast %count5 : i32 to index
  %slot5_0 = index.add %entries0, %count5_i : index
  %slot5 = index.assume %slot5_0 [range(%slot5_0, 1, 4088)] : index
  %e5 = view.load %idx_view[%five] : view<256xi32, #dense> -> i32
  %hit5 = scalar.cmpi eq, %e5, %expert_i32 : i32
  scf.if %hit5 {
    view.store %sel5_i32, %table_view[%slot5] : i32, view<4096xi32, #dense>
  }
  %inc5 = scf.select %hit5, %one_i32, %zero_i32 : i32
  %count6 = scalar.addi %count5, %inc5 : i32

  %count6_i = index.cast %count6 : i32 to index
  %slot6_0 = index.add %entries0, %count6_i : index
  %slot6 = index.assume %slot6_0 [range(%slot6_0, 1, 4088)] : index
  %e6 = view.load %idx_view[%six] : view<256xi32, #dense> -> i32
  %hit6 = scalar.cmpi eq, %e6, %expert_i32 : i32
  scf.if %hit6 {
    view.store %sel6_i32, %table_view[%slot6] : i32, view<4096xi32, #dense>
  }
  %inc6 = scf.select %hit6, %one_i32, %zero_i32 : i32
  %count7 = scalar.addi %count6, %inc6 : i32

  %count7_i = index.cast %count7 : i32 to index
  %slot7_0 = index.add %entries0, %count7_i : index
  %slot7 = index.assume %slot7_0 [range(%slot7_0, 1, 4088)] : index
  %e7 = view.load %idx_view[%seven] : view<256xi32, #dense> -> i32
  %hit7 = scalar.cmpi eq, %e7, %expert_i32 : i32
  scf.if %hit7 {
    view.store %sel7_i32, %table_view[%slot7] : i32, view<4096xi32, #dense>
  }
  %inc7 = scf.select %hit7, %one_i32, %zero_i32 : i32
  %count8 = scalar.addi %count7, %inc7 : i32

  view.store %count8, %table_view[%table_base] : i32, view<4096xi32, #dense>
  kernel.return
}
