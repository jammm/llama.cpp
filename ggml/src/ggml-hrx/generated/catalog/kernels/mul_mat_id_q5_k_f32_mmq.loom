  %sel_off = index.constant 2576 : offset
  %match_sel_view = buffer.view %scratch[%sel_off] : buffer -> view<128xi32, #dense>
  %act_off = index.constant 3088 : offset
  %act_packed_view = buffer.view %scratch[%act_off] : buffer -> view<1024xi32, #dense>
