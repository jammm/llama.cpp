        %vi7 = index.assume %vi7_0 [range(%vi7_0, 0, 1073741820)] : index
        %vals7 = vector.load %src1_view[%vi7] : view<1073741824xf32, #dense> -> vector<4xf32>
        %absv0 = vector.absf %vals0 : vector<4xf32>
        %tmax0 = vector.reduce<maxnumf, reassoc|nnan|nsz> %absv0, %zero_f32 : vector<4xf32>, f32
        %absv1 = vector.absf %vals1 : vector<4xf32>
        %tmax1 = vector.reduce<maxnumf, reassoc|nnan|nsz> %absv1, %zero_f32 : vector<4xf32>, f32
        %absv2 = vector.absf %vals2 : vector<4xf32>
        %tmax2 = vector.reduce<maxnumf, reassoc|nnan|nsz> %absv2, %zero_f32 : vector<4xf32>, f32
        %absv3 = vector.absf %vals3 : vector<4xf32>
        %tmax3 = vector.reduce<maxnumf, reassoc|nnan|nsz> %absv3, %zero_f32 : vector<4xf32>, f32
