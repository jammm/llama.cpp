// Descending argsort by rank counting.
//
// One workgroup a row, one lane a column, 32 chunks of 8 columns a lane, and a
// single barrier. Generated by gen_argsort_rank.py -- do not edit.

config.decl @hrx2.shape.argsort.ncols : %value: index where [range(%value, 256, 256)]
