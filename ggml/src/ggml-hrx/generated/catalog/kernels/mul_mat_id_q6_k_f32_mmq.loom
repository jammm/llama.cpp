        %ar1 = index.add %ar0, %tok_stride_lds : index
        %ar2 = index.add %ar1, %tok_stride_lds : index
        %ar3 = index.add %ar2, %tok_stride_lds : index
        %ar4 = index.add %ar3, %tok_stride_lds : index
        %ar5 = index.add %ar4, %tok_stride_lds : index
        %ar6 = index.add %ar5, %tok_stride_lds : index
        %ar7 = index.add %ar6, %tok_stride_lds : index
        %ts0_0 = index.add %tslot_base, %zero : index
        %ts0 = index.assume %ts0_0 [range(%ts0_0, 0, 15)] : index
        %asi0_0 = index.mul %ts0, %eight : index
        %asi0_1 = index.add %asi0_0, %g : index
        %asi0 = index.assume %asi0_1 [range(%asi0_1, 0, 127)] : index
        %asc0 = view.load %act_scale_view[%asi0] : view<128xf32, #dense> -> f32
        %sb0_0 = index.mul %ts0, %sixteen : index
