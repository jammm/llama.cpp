        %ts1_0 = index.add %tslot_base, %k_s1 : index
        %ts1 = index.assume %ts1_0 [range(%ts1_0, 0, 15)] : index
        %asi1_0 = index.mul %ts1, %eight : index
        %asi1_1 = index.add %asi1_0, %g : index
        %asi1 = index.assume %asi1_1 [range(%asi1_1, 0, 127)] : index
        %asc1 = view.load %act_scale_view[%asi1] : view<128xf32, #dense> -> f32
