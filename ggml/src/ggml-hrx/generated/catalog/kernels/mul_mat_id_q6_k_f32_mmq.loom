      %ql_payload = index.add %blk_byte_base, %qs_offset : index
      %qh_payload = index.add %blk_byte_base, %qh_offset : index

      %h0, %h1, %h2, %h3, %h4, %h5, %h6, %h7 = scf.for %g = [%zero to %eight step %one](
          %c0 = %b0 : f32,
          %c1 = %b1 : f32,
          %c2 = %b2 : f32,
          %c3 = %b3 : f32,
          %c4 = %b4 : f32,
          %c5 = %b5 : f32,
          %c6 = %b6 : f32,
          %c7 = %b7 : f32) -> (f32, f32, f32, f32, f32, f32, f32, f32) unroll(%eight) {
        // The 256-element superblock is four 32-element slices of each of two
        // 128-element halves. half = g/4 picks the half, case = g%4 the slice.
        // A slice takes its low 4 bits from ql -- low nibble when case < 2, high
