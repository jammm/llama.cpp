    %sa7 = vector.mma %qf7, %kf7, %sa6 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %sc1 = vector.addf %sa1, %sa3 : vector<8xf32>
    %sc2 = vector.addf %sc1, %sa5 : vector<8xf32>
    %sc3 = vector.addf %sc2, %sa7 : vector<8xf32>
    vector.fragment.store<result> %sc3, %sl_view[%zero, %zero] shape [%sixteen, %sixteen] : vector<8xf32>, view<16x16xf32, %res_layout>
    kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}

    // Online softmax, one query row a lane. A row's 16 scores are two vector
    // ops wide, so the row max and sum are vector reductions, not cross-lane.
    // Lead wave's first 16 lanes: dj*32 + lane < 16 is true only for dj=0.
    // Running it per wave instead, so no wave waits at the barrier, costs more in
    // duplicated exp() than it saves in idling: FA 889 -> 1055.6 us.
    %sm_key = index.add %sm_key0, %lane : index
    %sm_ok = index.cmp ult, %sm_key, %tq_c : index
    scf.if %sm_ok {
      %sr0 = index.mul %lane, %s_st : index
      %scv = vector.splat %scale : vector<8xf32>
      %mg0 = index.add %mk_g0, %kb : index
      // Permuted slot for this query: the accumulator reads these back as one
      // vector<8xf32> whose elements are queries (lane/16) + 2e.
      %pq_par = index.rem %lane, %two_c : index
      %pq_v = index.div %lane, %two_c : index
      %pq_0 = index.mul %pq_par, %eight : index
      %pq_1 = index.add %pq_0, %pq_v : index
      // Inside this guard dj is 0 and lane < 16, so the permutation stays in range.
      %pq = index.assume %pq_1 [range(%pq_1, 0, 15)] : index
      %sri0_0 = index.add %sr0, %zero : index
      %sri0 = index.assume %sri0_0 [range(%sri0_0, 0, 504)] : index
      %sv0_p0 = vector.load %sl_flat[%sri0] : view<512xf32, #dense> -> vector<8xf32>
      %spi1_0_0 = index.add %sri0, %k_sp1 : index
      %spi1_0 = index.assume %spi1_0_0 [range(%spi1_0_0, 0, 504)] : index
      %sv0_p1 = vector.load %sl_flat[%spi1_0] : view<512xf32, #dense> -> vector<8xf32>
      %sv0_a1 = vector.addf %sv0_p0, %sv0_p1 : vector<8xf32>
      %mgi0_0 = index.add %mg0, %zero : index
      %mgi0 = index.assume %mgi0_0 [range(%mgi0_0, 0, 536870904)] : index
      %mvh0 = vector.load %m_view[%mgi0] : view<536870912xf16, #dense> -> vector<8xf16>
      %mvf0 = vector.extf %mvh0 : vector<8xf16> to vector<8xf32>
      %mvc0 = vector.maxnumf %mvf0, %neg_big_v : vector<8xf32>
      %st0 = vector.fmaf %sv0_a1, %scv, %mvc0 : vector<8xf32>
      %rm0 = vector.reduce<maxnumf, reassoc|nnan|nsz> %st0, %neg_big : vector<8xf32>, f32
      %sri1_0 = index.add %sr0, %k_v1 : index
      %sri1 = index.assume %sri1_0 [range(%sri1_0, 0, 504)] : index
      %sv1_p0 = vector.load %sl_flat[%sri1] : view<512xf32, #dense> -> vector<8xf32>
      %spi1_1_0 = index.add %sri1, %k_sp1 : index
      %spi1_1 = index.assume %spi1_1_0 [range(%spi1_1_0, 0, 504)] : index
      %sv1_p1 = vector.load %sl_flat[%spi1_1] : view<512xf32, #dense> -> vector<8xf32>
      %sv1_a1 = vector.addf %sv1_p0, %sv1_p1 : vector<8xf32>
      %mgi1_0 = index.add %mg0, %k_v1 : index
      %mgi1 = index.assume %mgi1_0 [range(%mgi1_0, 0, 536870904)] : index
      %mvh1 = vector.load %m_view[%mgi1] : view<536870912xf16, #dense> -> vector<8xf16>
      %mvf1 = vector.extf %mvh1 : vector<8xf16> to vector<8xf32>
      %mvc1 = vector.maxnumf %mvf1, %neg_big_v : vector<8xf32>
      %st1 = vector.fmaf %sv1_a1, %scv, %mvc1 : vector<8xf32>
      %rm1 = vector.reduce<maxnumf, reassoc|nnan|nsz> %st1, %neg_big : vector<8xf32>, f32
      %rmx1 = scalar.maxnumf %rm0, %rm1 : f32
      %m_old = view.load %ml_view[%pq] : view<16xf32, #dense> -> f32
      %l_old = view.load %ll_view[%pq] : view<16xf32, #dense> -> f32
      %m_new = scalar.maxnumf %m_old, %rmx1 : f32
      %m_dif = scalar.subf<reassoc|nnan|nsz> %m_old, %m_new : f32
      %corr = scalar.expf<afn> %m_dif : f32
      %m_new_v = vector.splat %m_new : vector<8xf32>
      %sd0 = vector.subf<reassoc|nnan|nsz> %st0, %m_new_v : vector<8xf32>
      %pe0 = vector.expf<afn> %sd0 : vector<8xf32>
      %ps0 = vector.reduce<addf, reassoc|nnan|nsz> %pe0, %zero_f32 : vector<8xf32>, f32
      %ph0 = vector.fptrunc %pe0 : vector<8xf32> to vector<8xf16>
      %sd1 = vector.subf<reassoc|nnan|nsz> %st1, %m_new_v : vector<8xf32>
      %pe1 = vector.expf<afn> %sd1 : vector<8xf32>
      %ps1 = vector.reduce<addf, reassoc|nnan|nsz> %pe1, %zero_f32 : vector<8xf32>, f32
      %ph1 = vector.fptrunc %pe1 : vector<8xf32> to vector<8xf16>
      %pss1 = scalar.addf<reassoc|nnan|nsz> %ps0, %ps1 : f32
      %pdi0_0 = index.add %sr0, %zero : index
      %pdi0 = index.assume %pdi0_0 [range(%pdi0_0, 0, 248)] : index
      vector.store %ph0, %pl_flat[%pdi0] : vector<8xf16>, view<256xf16, #dense>
      %pdi1_0 = index.add %sr0, %k_v1 : index
      %pdi1 = index.assume %pdi1_0 [range(%pdi1_0, 0, 248)] : index
      vector.store %ph1, %pl_flat[%pdi1] : vector<8xf16>, view<256xf16, #dense>
      %l_new = scalar.fmaf<reassoc|nnan|nsz> %l_old, %corr, %pss1 : f32
      view.store %m_new, %ml_view[%pq] : f32, view<16xf32, #dense>
      view.store %l_new, %ll_view[%pq] : f32, view<16xf32, #dense>
      view.store %corr, %cl_view[%pq] : f32, view<16xf32, #dense>
    }
    kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}

    // O = O*corr + P*V. A lane's 8 accumulator elements are queries
    // (lane/16) + 2e, which is the order the softmax state was stored in, so the
    // per-query rescale is one vector load and folds into the accumulate.
    %cvi = index.assume %acc_m0 [range(%acc_m0, 0, 8)] : index
    %cvec = vector.load %cl_view[%cvi] : view<16xf32, #dense> -> vector<8xf32>
    %pfr = vector.fragment.load<lhs> %pl_view[%zero, %zero] shape [%sixteen, %sixteen] : view<16x16xf16, %lhs_p_layout> -> vector<16xf16>
    %vfr0 = vector.fragment.load<rhs> %vl_view[%zero, %kc0] shape [%sixteen, %sixteen] : view<16x256xf16, %rhs_v_layout> -> vector<16xf16>
    %pv0 = vector.mma %pfr, %vfr0, %fzero : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %ou0 = vector.fmaf %oc0, %cvec, %pv0 : vector<8xf32>
    %vfr1 = vector.fragment.load<rhs> %vl_view[%zero, %kc1] shape [%sixteen, %sixteen] : view<16x256xf16, %rhs_v_layout> -> vector<16xf16>
    %pv1 = vector.mma %pfr, %vfr1, %fzero : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %ou1 = vector.fmaf %oc1, %cvec, %pv1 : vector<8xf32>
    %vfr2 = vector.fragment.load<rhs> %vl_view[%zero, %kc2] shape [%sixteen, %sixteen] : view<16x256xf16, %rhs_v_layout> -> vector<16xf16>
    %pv2 = vector.mma %pfr, %vfr2, %fzero : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %ou2 = vector.fmaf %oc2, %cvec, %pv2 : vector<8xf32>
    %vfr3 = vector.fragment.load<rhs> %vl_view[%zero, %kc3] shape [%sixteen, %sixteen] : view<16x256xf16, %rhs_v_layout> -> vector<16xf16>
    %pv3 = vector.mma %pfr, %vfr3, %fzero : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %ou3 = vector.fmaf %oc3, %cvec, %pv3 : vector<8xf32>
    %vfr4 = vector.fragment.load<rhs> %vl_view[%zero, %kc4] shape [%sixteen, %sixteen] : view<16x256xf16, %rhs_v_layout> -> vector<16xf16>
    %pv4 = vector.mma %pfr, %vfr4, %fzero : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %ou4 = vector.fmaf %oc4, %cvec, %pv4 : vector<8xf32>
    %vfr5 = vector.fragment.load<rhs> %vl_view[%zero, %kc5] shape [%sixteen, %sixteen] : view<16x256xf16, %rhs_v_layout> -> vector<16xf16>
    %pv5 = vector.mma %pfr, %vfr5, %fzero : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %ou5 = vector.fmaf %oc5, %cvec, %pv5 : vector<8xf32>
    %vfr6 = vector.fragment.load<rhs> %vl_view[%zero, %kc6] shape [%sixteen, %sixteen] : view<16x256xf16, %rhs_v_layout> -> vector<16xf16>
    %pv6 = vector.mma %pfr, %vfr6, %fzero : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %ou6 = vector.fmaf %oc6, %cvec, %pv6 : vector<8xf32>
    %vfr7 = vector.fragment.load<rhs> %vl_view[%zero, %kc7] shape [%sixteen, %sixteen] : view<16x256xf16, %rhs_v_layout> -> vector<16xf16>
    %pv7 = vector.mma %pfr, %vfr7, %fzero : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %ou7 = vector.fmaf %oc7, %cvec, %pv7 : vector<8xf32>
    kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
      scf.yield %ou0, %ou1, %ou2, %ou3, %ou4, %ou5, %ou6, %ou7 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
    } else {
      scf.yield %oc0, %oc1, %oc2, %oc3, %oc4, %oc5, %oc6, %oc7 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
    }
    scf.yield %on0, %on1, %on2, %on3, %on4, %on5, %on6, %on7, %kbn0, %kbn1, %vbn0, %vbn1 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<16xf16>, vector<16xf16>, vector<16xf16>, vector<16xf16>
  }

  // Normalise and write out. The destination row stride is a runtime value and
  // `encoding.layout.strided` mis-addresses with one, so the result lands in LDS
  // under a compile-time layout first. Q is dead by now and its region is
  // exactly the right size.
  %lvi = index.assume %acc_m0 [range(%acc_m0, 0, 8)] : index
  %lvec = vector.load %ll_view[%lvi] : view<16xf32, #dense> -> vector<8xf32>
  %one_v = vector.splat %one_f32 : vector<8xf32>
  %tiny = scalar.constant 1.0e-30 : f32
  %tiny_v = vector.splat %tiny : vector<8xf32>
  %lvec_s = vector.maxnumf %lvec, %tiny_v : vector<8xf32>
  %rl = vector.divf %one_v, %lvec_s : vector<8xf32>
  // Copy-out in rounds of 2 fragments. Every wave needs its own staging area
  // and there are 4 of them, so the round is sized to fit them all inside the
  // Q region, which is dead by now.
  %o_layout = encoding.layout.strided [36, 1] : encoding<layout>
  %w_ep = index.mul %wid, %k_epsz : index
  %w_ep_o = index.cast %w_ep : index to offset
  %ol_view = buffer.view %scratch[%w_ep_o] : buffer -> view<16x32xf32, %o_layout>
  %ol_flat = buffer.view %scratch[%w_ep_o] : buffer -> view<576xf32, #dense>
  %eq_row = index.div %lane, %two_c : index
  %eq_sub = index.rem %lane, %two_c : index
  %k_ehalf = index.constant 16 : index
  %eq_db = index.mul %eq_sub, %k_ehalf : index
  %eq_l0 = index.mul %eq_row, %k_epst : index
  %eq_l = index.add %eq_l0, %eq_db : index
  %eq_tok = index.add %qbase, %eq_row : index
  %eq_ok = index.cmp ult, %eq_tok, %ntokens_b : index
  %eq_g0 = index.mul %eq_tok, %o_st : index
  %eq_g1 = index.mul %head, %o_sh : index
  %eq_g2 = index.add %eq_g0, %eq_g1 : index
  %eq_g3 = index.add %eq_g2, %dj_off : index
  %eq_g = index.add %eq_g3, %eq_db : index
  kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
  %og0 = vector.mulf %of0, %rl : vector<8xf32>
  vector.fragment.store<result> %og0, %ol_view[%zero, %zero] shape [%sixteen, %sixteen] : vector<8xf32>, view<16x32xf32, %o_layout>
  %og1 = vector.mulf %of1, %rl : vector<8xf32>
  vector.fragment.store<result> %og1, %ol_view[%zero, %k_f1c] shape [%sixteen, %sixteen] : vector<8xf32>, view<16x32xf32, %o_layout>
  kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
  scf.if %eq_ok {
    %osl0_0_0 = index.add %eq_l, %zero : index
    %osl0_0 = index.assume %osl0_0_0 [range(%osl0_0_0, 0, 568)] : index
    %osv0_0 = vector.load %ol_flat[%osl0_0] : view<576xf32, #dense> -> vector<8xf32>
    %osg0_0_0 = index.add %eq_g, %zero : index
    %osg0_0 = index.assume %osg0_0_0 [range(%osg0_0_0, 0, 268435448)] : index
    vector.store %osv0_0, %o_view[%osg0_0] : vector<8xf32>, view<268435456xf32, #dense>
    %osl0_1_0 = index.add %eq_l, %k_v1 : index
    %osl0_1 = index.assume %osl0_1_0 [range(%osl0_1_0, 0, 568)] : index
    %osv0_1 = vector.load %ol_flat[%osl0_1] : view<576xf32, #dense> -> vector<8xf32>
    %osg0_1_0 = index.add %eq_g, %k_or0_1 : index
    %osg0_1 = index.assume %osg0_1_0 [range(%osg0_1_0, 0, 268435448)] : index
    vector.store %osv0_1, %o_view[%osg0_1] : vector<8xf32>, view<268435456xf32, #dense>
  }
  kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
  %og2 = vector.mulf %of2, %rl : vector<8xf32>
  vector.fragment.store<result> %og2, %ol_view[%zero, %zero] shape [%sixteen, %sixteen] : vector<8xf32>, view<16x32xf32, %o_layout>
  %og3 = vector.mulf %of3, %rl : vector<8xf32>
  vector.fragment.store<result> %og3, %ol_view[%zero, %k_f1c] shape [%sixteen, %sixteen] : vector<8xf32>, view<16x32xf32, %o_layout>
  kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
  scf.if %eq_ok {
    %osl1_0_0 = index.add %eq_l, %zero : index
    %osl1_0 = index.assume %osl1_0_0 [range(%osl1_0_0, 0, 568)] : index
    %osv1_0 = vector.load %ol_flat[%osl1_0] : view<576xf32, #dense> -> vector<8xf32>
    %osg1_0_0 = index.add %eq_g, %k_or1_0 : index
    %osg1_0 = index.assume %osg1_0_0 [range(%osg1_0_0, 0, 268435448)] : index
    vector.store %osv1_0, %o_view[%osg1_0] : vector<8xf32>, view<268435456xf32, #dense>
    %osl1_1_0 = index.add %eq_l, %k_v1 : index
    %osl1_1 = index.assume %osl1_1_0 [range(%osl1_1_0, 0, 568)] : index
    %osv1_1 = vector.load %ol_flat[%osl1_1] : view<576xf32, #dense> -> vector<8xf32>
    %osg1_1_0 = index.add %eq_g, %k_or1_1 : index
    %osg1_1 = index.assume %osg1_1_0 [range(%osg1_1_0, 0, 268435448)] : index
    vector.store %osv1_1, %o_view[%osg1_1] : vector<8xf32>, view<268435456xf32, #dense>
  }
  kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
  %og4 = vector.mulf %of4, %rl : vector<8xf32>
  vector.fragment.store<result> %og4, %ol_view[%zero, %zero] shape [%sixteen, %sixteen] : vector<8xf32>, view<16x32xf32, %o_layout>
  %og5 = vector.mulf %of5, %rl : vector<8xf32>
  vector.fragment.store<result> %og5, %ol_view[%zero, %k_f1c] shape [%sixteen, %sixteen] : vector<8xf32>, view<16x32xf32, %o_layout>
  kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
  scf.if %eq_ok {
    %osl2_0_0 = index.add %eq_l, %zero : index
    %osl2_0 = index.assume %osl2_0_0 [range(%osl2_0_0, 0, 568)] : index
    %osv2_0 = vector.load %ol_flat[%osl2_0] : view<576xf32, #dense> -> vector<8xf32>
    %osg2_0_0 = index.add %eq_g, %k_or2_0 : index
    %osg2_0 = index.assume %osg2_0_0 [range(%osg2_0_0, 0, 268435448)] : index
    vector.store %osv2_0, %o_view[%osg2_0] : vector<8xf32>, view<268435456xf32, #dense>
    %osl2_1_0 = index.add %eq_l, %k_v1 : index
    %osl2_1 = index.assume %osl2_1_0 [range(%osl2_1_0, 0, 568)] : index
    %osv2_1 = vector.load %ol_flat[%osl2_1] : view<576xf32, #dense> -> vector<8xf32>
    %osg2_1_0 = index.add %eq_g, %k_or2_1 : index
    %osg2_1 = index.assume %osg2_1_0 [range(%osg2_1_0, 0, 268435448)] : index
    vector.store %osv2_1, %o_view[%osg2_1] : vector<8xf32>, view<268435456xf32, #dense>
  }
  kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
  %og6 = vector.mulf %of6, %rl : vector<8xf32>
  vector.fragment.store<result> %og6, %ol_view[%zero, %zero] shape [%sixteen, %sixteen] : vector<8xf32>, view<16x32xf32, %o_layout>
  %og7 = vector.mulf %of7, %rl : vector<8xf32>
  vector.fragment.store<result> %og7, %ol_view[%zero, %k_f1c] shape [%sixteen, %sixteen] : vector<8xf32>, view<16x32xf32, %o_layout>
  kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
  scf.if %eq_ok {
    %osl3_0_0 = index.add %eq_l, %zero : index
    %osl3_0 = index.assume %osl3_0_0 [range(%osl3_0_0, 0, 568)] : index
    %osv3_0 = vector.load %ol_flat[%osl3_0] : view<576xf32, #dense> -> vector<8xf32>
    %osg3_0_0 = index.add %eq_g, %k_or3_0 : index
    %osg3_0 = index.assume %osg3_0_0 [range(%osg3_0_0, 0, 268435448)] : index
    vector.store %osv3_0, %o_view[%osg3_0] : vector<8xf32>, view<268435456xf32, #dense>
    %osl3_1_0 = index.add %eq_l, %k_v1 : index
    %osl3_1 = index.assume %osl3_1_0 [range(%osl3_1_0, 0, 568)] : index
    %osv3_1 = vector.load %ol_flat[%osl3_1] : view<576xf32, #dense> -> vector<8xf32>
    %osg3_1_0 = index.add %eq_g, %k_or3_1 : index
    %osg3_1 = index.assume %osg3_1_0 [range(%osg3_1_0, 0, 268435448)] : index
    vector.store %osv3_1, %o_view[%osg3_1] : vector<8xf32>, view<268435456xf32, #dense>
  }
  kernel.return
}
