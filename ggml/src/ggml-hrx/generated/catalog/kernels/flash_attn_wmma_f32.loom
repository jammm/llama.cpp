      %oc0 = %fzero_v : vector<8xf32>, %oc1 = %fzero_v : vector<8xf32>, %oc2 = %fzero_v : vector<8xf32>, %oc3 = %fzero_v : vector<8xf32>, %oc4 = %fzero_v : vector<8xf32>, %oc5 = %fzero_v : vector<8xf32>, %oc6 = %fzero_v : vector<8xf32>, %oc7 = %fzero_v : vector<8xf32>, %kbuf0 = %kpre0 : vector<16xf16>, %kbuf1 = %kpre1 : vector<16xf16>, %vbuf0 = %vpre0 : vector<16xf16>, %vbuf1 = %vpre1 : vector<16xf16>)
